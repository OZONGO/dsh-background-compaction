{
  "name": "dsh-background-compaction",
  "version": "0.1.0",
  "description": "Background context compaction for DeepSeek Harness: summarize ahead of the threshold, swap in on the next turn.",
  "type": "module",
  "license": "MIT",
  "author": "OZONGO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OZONGO/dsh-background-compaction.git"
  },
  "homepage": "https://github.com/OZONGO/dsh-background-compaction#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "compaction",
    "context",
    "deepseek-harness"
  ],
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-compaction": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
